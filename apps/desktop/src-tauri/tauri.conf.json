{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal AI OS",
  "version": "2.0.0",
  "identifier": "local.paios.desktop",
  "build": {
    "beforeDevCommand": "node scripts/start-dev-server.mjs",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "node scripts/build-release.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Personal AI OS",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:4738 http://127.0.0.1:5173; connect-src 'self' http://127.0.0.1:4738 http://127.0.0.1:5173 https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": ["resources/node.exe", "resources/paios-server/**/*"],
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
